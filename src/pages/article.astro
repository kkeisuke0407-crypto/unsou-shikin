---
import ArticleLayout from "../layouts/ArticleLayout.astro";

const A8 = "https://px.a8.net/svt/ejp?a8mat=4B9YLD+3SXUJM+5KPA+NTZCH";
const UPDATED = "2026年8月5日";

const toc = [
  ["conclusion", "結論：法人で300万円以上、期日が決まっているなら"],
  ["check", "30秒でわかる自己チェック"],
  ["structure", "なぜ「売上があるのに資金が足りない」が起きるのか"],
  ["compare", "運送業が使える5つの選択肢"],
  ["company", "アクト・ウィルはどんな会社か"],
  ["terms", "公式サイトで確認できた貸付条件"],
  ["flow", "申し込みから契約までの流れ"],
  ["fit", "向いているケース・向いていないケース"],
  ["before", "相談する前に確認したい5つのこと"],
  ["faq", "よくある質問"],
  ["summary", "まとめ"],
];

const methods = [
  {
    icon: "bank",
    name: "日本政策金融公庫の融資",
    speed: "時間がかかる",
    cost: "無担保 年3.60〜5.30%",
    need: "決算書・事業計画",
    text: "金利を最優先し、時間に余裕がある場合の第一候補。2026年8月3日現在の国民生活事業の基準利率は、無担保で年3.60〜5.30%、有担保で年2.60〜4.90%です。",
  },
  {
    icon: "home",
    name: "信用保証協会付き融資・銀行のプロパー融資",
    speed: "時間がかかる",
    cost: "一般に低め",
    need: "決算書・取引実績",
    text: "メインバンクとの関係があり、計画的に調達する場合に向きます。銀行と保証協会の二段階の審査を経るため、着金までの日数は読みにくくなります。",
  },
  {
    icon: "hand",
    name: "ノンバンクのビジネスローン",
    speed: "公庫・銀行より短い傾向",
    cost: "銀行より高くなる傾向",
    need: "決算書類・本人確認書類",
    text: "支払期日が決まっていて、審査結果を待つ時間がない場合の選択肢。金利の上限は利息制限法により、元本100万円以上で年15%と定められています。この記事で扱うアクト・ウィルはここに含まれます。",
    pick: true,
  },
  {
    icon: "document",
    name: "ファクタリング（売掛債権の売却）",
    speed: "短い傾向",
    cost: "手数料方式",
    need: "確定した請求書",
    text: "借入ではなく債権の譲渡なので、負債は増えません。ただし金融庁は、実態が貸付である「偽装ファクタリング」や、無登録業者による高額な手数料について注意を呼びかけています。",
  },
  {
    icon: "truck",
    name: "トラックのリースバック・車両担保",
    speed: "中程度",
    cost: "個別の条件による",
    need: "売却・担保にできる車両",
    text: "保有する車両を売却し、そのまま賃借して使い続ける方法です。車両を手放さずに資金化できますが、契約期間中の解約や改造には制約が生じます。",
  },
];

const terms = [
  ["融資対象", "法人", ""],
  ["ご融資金額", "300万円〜1億円", ""],
  ["実質年率", "3.00%〜15.00%", "融資額に応じて金利優遇あり"],
  ["遅れ損害金年率", "20.00%", ""],
  ["返済方法", "一括または分割返済", "元金均等払い"],
  ["返済期間・回数", "1ヶ月〜3年 / 1回〜36回", ""],
  ["保証人・担保", "第三者保証人・不動産担保は原則不要（要審査）", "法人契約のため代表者の連帯保証は必要"],
  ["必要書類", "代表者本人を確認する書類、決算書類の一部", "損益計算書、売掛金・買掛金の内訳書など"],
  ["契約時締結費用", "印紙代（実費）", ""],
  ["対応エリア", "来店不要・全国対応", ""],
  ["審査", "最短60分", "仮審査の目安"],
  ["申込方法", "公式サイト上の専用チャット", "電話での新規申し込みは受付なし"],
];

const verify = [
  ["商号", "アクト・ウィル株式会社"],
  ["貸金業登録番号", "東京都知事（5）第31521号"],
  ["代表者", "谷口 友祐（タニグチ ユウスケ）"],
  ["所在地", "東京都豊島区東池袋3-11-9 三島ビル301号室"],
  ["電話番号", "03-5944-9168"],
  ["日本貸金業協会 会員番号", "第005834号"],
];

const faqs = [
  ["個人事業主でも利用できますか？", "公式サイトには「融資対象：法人」と記載されています。個人事業主の方は、日本政策金融公庫の融資やファクタリングなど別の手段をご検討ください。"],
  ["他社からの借入があっても相談できますか？", "事業性の法人向け貸付は、貸金業法の総量規制（個人の借入残高を年収の3分の1までに制限する規制）の対象外です。既に借入があることだけを理由に申し込めないわけではありませんが、返済能力に関する審査はあります。"],
  ["審査に通るか不安です。", "審査の基準は公開されておらず、通過を保証できる情報はありません。公式サイトのよくある質問では「他社で断られた場合でも申し込みは可能で、仮審査を行う」旨が案内されていますが、これは申し込みができるという意味であり、融資が受けられるという意味ではありません。"],
  ["本当に即日で資金を受け取れますか？", "公式サイトには「最短即日契約可能」と記載されている一方で、「お申し込みいただいた段階で審査があるため、即日融資実行ができないこともある」とも明記されています。急ぐ場合は午前中までの申し込みがスムーズだと案内されていますが、即日を確約するものではありません。"],
  ["担保や保証人は必要ですか？", "法人契約となるため、代表者の連帯保証は必要です。そのうえで、第三者の保証人や不動産担保は原則不要と記載されています。ただし「一部の融資業務については担保が必要な場合がある」とも記載されており、いずれも審査によります。"],
  ["相談したら、営業電話がかかってきませんか？", "公式サイトには「弊社から電話営業を行うことはございません」と明記されています。また、新規の申し込みは公式サイト上の専用チャットから受け付けており、電話での新規申し込みは受け付けていないと案内されています。"],
  ["来店は必要ですか？地方でも利用できますか？", "公式サイトには「ご来店不要で全国対応」と記載されています。契約後の資金の受け取りは、指定口座への振込、または担当者が現金を直接届ける方法が案内されています。"],
  ["相談した後に断ることはできますか？", "相談や仮審査の申し込みは、契約の締結ではありません。提示された金利・返済額・期間を確認したうえで判断してください。条件に納得できない場合、契約しないという選択は当然に可能です。"],
];
---

<ArticleLayout
  title="運送業の資金調達｜法人向け300万円〜1億円のビジネスローンという選択肢"
  description="運送事業を営む法人向けの資金調達を、公庫・銀行・ビジネスローン・ファクタリング・車両活用の5つで比較。公式サイトと金融庁の登録情報で確認した貸付条件、向いていないケースまで整理しました。"
  updated={UPDATED}
>
  <header class="article-head">
    <p class="article-head__meta">
      <span>最終更新 {UPDATED}</span><span>運送業 / 法人向け</span><span>公式・公的資料で確認</span>
    </p>
    <h1>運送業の資金調達｜法人向けに<strong>300万円〜1億円</strong>、来店不要で全国対応のビジネスローンという選択肢</h1>
    <p class="article-head__lead">
      燃料費も高速代も人件費も、先に出ていきます。運賃の入金は、その後です。このズレは経営の巧拙ではなく、
      運送業という仕事の構造から生まれています。そして、支払期日のほうは動かせません。
    </p>
    <div class="article-head__target">
      <p>この記事の対象</p>
      <ul>
        <li>一般貨物・軽貨物などの運送事業を営む<strong>法人</strong></li>
        <li>必要な資金が<strong>300万円以上</strong></li>
        <li>支払期日が決まっていて、<strong>時間に余裕がない</strong></li>
      </ul>
      <small>上記に当てはまらない方向けの選択肢も、記事の後半で整理しています。</small>
    </div>
  </header>

  <nav class="toc" aria-label="目次">
    <h2><svg aria-hidden="true"><use href="#i-book" /></svg>この記事の内容</h2>
    <ol>
      {toc.map(([id, label]) => (
        <li><a href={`#${id}`}>{label}</a></li>
      ))}
    </ol>
  </nav>

  <div class="prose">
    <section id="conclusion">
      <h2>結論：法人で300万円以上、期日が決まっているなら「ノンバンクのビジネスローン」が現実的な候補になる</h2>
      <p>
        先に結論をお伝えします。<strong>金利の低さだけで選ぶなら、日本政策金融公庫や銀行の融資が有利です。</strong>
        これは間違いありません。ただし、相談から実行までに一定の時間がかかります。支払期日まで日数がない場合、
        そもそも間に合わないという問題が起きます。
      </p>
      <p>
        そこで候補に挙がるのが、ノンバンク（銀行以外の貸金業者）のビジネスローンです。銀行より金利は高くなる傾向がありますが、
        審査から実行までの時間は短い傾向にあります。その一社が、運送事業者向けに貸付条件を公開している
        アクト・ウィル株式会社です。
      </p>
      <p>
        この記事では、他の資金調達方法との違い、公式に確認できた条件、そして<strong>向いていないケース</strong>まで確認していきます。
      </p>

      <div class="cta-block">
        <p class="cta-block__lead">
          アクト・ウィルの貸付条件は公式サイトに公開されています。融資対象は法人、融資金額は300万円〜1億円、
          実質年率は3.00%〜15.00%です。相談は無料で、公式サイトには<strong>「弊社から電話営業を行うことはございません」</strong>と明記されています。
        </p>
        <a class="finance-cta" href={A8} rel="nofollow sponsored noopener" target="_blank">
          <span class="finance-cta__caption">ご融資可能額（目安）</span>
          <strong class="finance-cta__amount" aria-label="300万円から1億円">300<small>万円〜</small>1<small>億円</small></strong>
          <span class="finance-cta__button">公式サイトで貸付条件を確認する <b aria-hidden="true">›</b></span>
          <span class="finance-cta__note">相談は無料です</span>
        </a>
        <p class="cta-block__disclaimer">※審査があるため、融資を保証するものではありません。</p>
      </div>
    </section>

    <section id="check">
      <h2>30秒でわかる｜あなたの会社はどの資金調達から検討すべきか</h2>
      <p>
        資金調達の手段は、会社の形態・必要な金額・手元にある資産によって大きく変わります。
        まず3つの質問で、自社がどこから検討すべきかを確認してください。
      </p>

      <div class="data-list">
        <div>
          <dt>Q1. 法人ですか？</dt>
          <dd>はい → Q2へ<em>いいえ（個人事業主）→ この記事で紹介するビジネスローンの融資対象は法人です。日本政策金融公庫の融資や、請求書を使うファクタリングから検討するのが現実的です。</em></dd>
        </div>
        <div>
          <dt>Q2. 必要な金額は300万円以上ですか？</dt>
          <dd>はい → Q3へ<em>いいえ → このビジネスローンの最低融資額は300万円です。少額に対応しているビジネスローンやファクタリングをご検討ください。</em></dd>
        </div>
        <div>
          <dt>Q3. 資金が必要な期日まで、1か月を切っていますか？</dt>
          <dd>はい → この記事の内容がそのまま当てはまります<em>いいえ → 金利面で有利な日本政策金融公庫や銀行への相談を先に進めてください。並行してノンバンクの条件も調べておくと、いざというときに選択肢が残ります。</em></dd>
        </div>
      </div>
    </section>

    <section id="structure">
      <h2>なぜ運送業は「売上があるのに資金が足りない」が起きるのか</h2>
      <p>自社だけの問題だと感じている方が多い部分です。しかし、データを見るとこれは業界の構造から生じています。</p>

      <h3>出ていくのが先、入ってくるのが後</h3>
      <p>
        燃料費と高速代は走った分だけその場で発生し、ドライバーの給与は毎月決まった日に支払う必要があります。
        車検・整備・タイヤ交換・突発的な修理は金額が大きく、しかも車両を止めれば売上が立ちません。
        一方で、運賃の入金は締め日と支払日を経た後です。
      </p>
      <p>
        2026年1月に施行された中小受託取引適正化法（取適法、旧・下請法）により、手形による支払いは原則禁止され、
        支払期日は受領後60日以内と定められました。制度としては前進していますが、
        <strong>それでも「先に払って、後で受け取る」という順番そのものは変わりません。</strong>
      </p>

      <h3>上がったコストが運賃に乗るまでの時間差</h3>
      <p>
        中小企業庁が2026年6月26日に公表した「価格交渉促進月間（2026年3月）フォローアップ調査」（回答企業69,625社）によると、
        全業種の価格転嫁率は54.2%でした。コスト要素別に見ると、<strong>エネルギーコストの転嫁率は48.9%</strong>、労務費は50.0%です。
        つまり、燃料や人件費が上がっても、上昇分のおよそ半分しか価格に反映できていないのが全業種の平均です。
      </p>
      <p>
        そして同調査の業種別ランキングで、<strong>トラック運送業は価格交渉の実施状況・価格転嫁率とも32業種中で最下位圏</strong>と報じられています
        （価格交渉ができなかった企業が13.3%、受注者としての価格転嫁率は36.9%）。この差が、そのまま運転資金の必要性になっています。
      </p>

      <h3>売上は増えても、利益率は薄い</h3>
      <div class="data-list">
        <div><dt>営業損益率（全体）</dt><dd>1.0%<em>前年比 +0.4ポイント</em></dd></div>
        <div><dt>営業赤字の事業者</dt><dd>48%</dd></div>
        <div><dt>車両10台以下の営業損益率</dt><dd>−2.3%<em>営業赤字の割合は62%</em></dd></div>
        <div><dt>1者平均の売上高</dt><dd>2億8,521万5,000円<em>前年比 +8.0%</em></dd></div>
        <div><dt>燃料費率</dt><dd>13.5%</dd></div>
        <div><dt>軽油価格（平均）</dt><dd>166.7円<em>前年比 +9.2%</em></dd></div>
      </div>
      <p class="source">出典：全日本トラック協会「経営分析報告書 令和6年度決算版」（2026年4月公表、分析対象2,631者・報道による）／中小企業庁「価格交渉促進月間（2026年3月）フォローアップ調査」（2026年6月26日公表）</p>
      <p>
        注目したいのは、<strong>売上高は前年比8.0%増えているのに、営業損益率は1.0%にとどまっている</strong>点です。
        売上が増えれば、その分だけ先に立て替える燃料費や人件費も増えます。
        「仕事は増えているのに手元の現金が減る」という感覚には、こうした背景があります。
      </p>

      <div class="note">
        <p class="note__label"><svg aria-hidden="true"><use href="#i-scale" /></svg>制度は前進しているが、時間差は残る</p>
        <p>
          国土交通省は2024年3月22日に「標準的な運賃」を告示し、運賃水準を平均約8%引き上げ、燃料サーチャージの基準価格を120.00円/Lと明示しました。
          荷待ち・荷役が合計2時間を超える場合の割増率5割も新設されています。ただし告示であり、
          実際の運賃交渉がまとまるまでには時間がかかります。
        </p>
      </div>
    </section>

    <section id="compare">
      <h2>運送業が使える資金調達の選択肢を、5つに整理する</h2>
      <p>
        資金調達の方法は大きく5つに分けられます。それぞれ「お金の出どころ」が違うため、
        必要なものも、かかる時間も、コストの考え方も異なります。
      </p>

      <div class="compare-stack">
        {methods.map(({ icon, name, speed, cost, need, text, pick }) => (
          <article class:list={["compare-item", pick && "compare-item--pick"]}>
            <h3><svg aria-hidden="true"><use href={`#i-${icon}`} /></svg>{name}</h3>
            <div class="compare-item__specs">
              <div><span>スピード</span><strong>{speed}</strong></div>
              <div><span>コスト</span><strong>{cost}</strong></div>
              <div><span>必要なもの</span><strong>{need}</strong></div>
            </div>
            <p>{text}</p>
          </article>
        ))}
      </div>

      <p>
        判断の軸はシンプルです。<strong>金利で選ぶなら公庫や銀行。期日で選ぶならビジネスローン、ファクタリング、車両活用。</strong>
        ただしファクタリングは確定した請求書、リースバックは車両が前提になります。
      </p>
      <p>
        そしてもう一点、見落とされがちな観点があります。<strong>間に合わない選択肢は、選択肢になりません。</strong>
        金利が安くても、支払期日を過ぎてから実行される融資では目的を果たせません。運送業の場合、
        給与・燃料・車検といった支払いは期日を動かせないことが多く、「間に合うかどうか」が第一条件になる場面が少なくありません。
      </p>

      <div class="cta-block">
        <p class="cta-block__lead">
          ノンバンクのビジネスローンのうち、運送事業者向けに貸付条件を公開している一社がアクト・ウィルです。
          <strong>融資対象は法人、300万円〜1億円、実質年率3.00%〜15.00%、来店不要で全国対応</strong>と公式サイトに記載されています。
        </p>
        <a class="finance-cta" href={A8} rel="nofollow sponsored noopener" target="_blank">
          <span class="finance-cta__caption">審査</span>
          <strong class="finance-cta__amount" aria-label="最短60分">最短<small>60</small>分<small>（仮審査）</small></strong>
          <span class="finance-cta__button">運送業向けの条件を見る <b aria-hidden="true">›</b></span>
          <span class="finance-cta__note">公式サイトへ移動します</span>
        </a>
        <p class="cta-block__disclaimer">※相談は無料です。審査があるため、融資を保証するものではありません。</p>
      </div>
    </section>

    <section id="company">
      <h2>アクト・ウィルはどんな会社か｜金融庁の登録情報で確認できること</h2>
      <p>
        はじめて名前を聞く会社に資金の相談をするのは、当然ためらいがあると思います。
        ここは印象や口コミではなく、<strong>公的なデータで確認できることだけ</strong>を書きます。
      </p>

      <h3>貸金業登録は、金融庁のサイトで誰でも確認できる</h3>
      <p>
        事業者向けの貸付を業として行うには、国または都道府県の貸金業登録が必要です。
        そして登録された業者の情報は、金融庁の「登録貸金業者情報検索サービス」で誰でも無料で照会できます。
      </p>
      <ol>
        <li>金融庁「登録貸金業者情報検索サービス」を開く</li>
        <li>「商号・名称」の欄に会社名を入力して検索する</li>
        <li>表示された登録番号・所在地・電話番号が、その会社の広告や公式サイトの表記と一致しているかを確認する</li>
      </ol>
      <p>貸金業登録は3年ごとの更新制です。登録（更新）日も同じ画面で確認できます。</p>

      <h3>公式サイトの表記と、登録情報は一致しているか</h3>
      <p>同サービスで「アクト・ウィル」を検索したところ、該当は1件でした。公式サイトの表記と照合した結果が次のとおりです。</p>

      <div class="verify-list">
        {verify.map(([key, value]) => (
          <div class="verify-item">
