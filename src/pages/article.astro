---
import ArticleLayout from "../layouts/ArticleLayout.astro";

const A8 = "https://px.a8.net/svt/ejp?a8mat=4B9YLD+3SXUJM+5KPA+NTZCH";
const UPDATED = "2026年8月6日";

const toc = [
  ["conclusion", "結論｜先に答えを書きます"],
  ["check", "対象判定｜30秒で自社が当てはまるか確認"],
  ["why", "理由｜なぜ「売上があるのに金がない」のか"],
  ["compare", "比較｜運送業が使える5つの選択肢"],
  ["company", "会社｜金融庁の登録情報で確認できること"],
  ["terms", "条件｜公式サイトに載っている全項目"],
  ["flow", "流れ｜申込から契約までの4ステップ"],
  ["fit", "適否｜向いているケース・向いていないケース"],
  ["before", "準備｜相談する前に確認したい5つのこと"],
  ["faq", "よくある質問"],
  ["summary", "まとめ"],
];

const methods = [
  {
    icon: "bank",
    name: "日本政策金融公庫の融資",
    speed: "遅い",
    cost: "年3.60〜5.30%",
    need: "決算書・事業計画",
    text: "金利を最優先し、時間に余裕があるなら第一候補です。2026年8月3日現在の国民生活事業の基準利率は、無担保で年3.60〜5.30%、有担保で年2.60〜4.90%。",
  },
  {
    icon: "home",
    name: "信用保証協会付き融資・銀行のプロパー融資",
    speed: "遅い",
    cost: "一般に低め",
    need: "決算書・取引実績",
    text: "メインバンクとの関係があり、計画的に調達する場合に向きます。銀行と保証協会の二段階の審査を経るため、着金までの日数は読みにくくなります。",
  },
  {
    icon: "hand",
    name: "ノンバンクのビジネスローン",
    speed: "速い傾向",
    cost: "銀行より高い",
    need: "決算書類・本人確認書類",
    text: "支払期日が決まっていて、審査結果を待つ時間がない場合の選択肢。金利の上限は利息制限法により、元本100万円以上で年15%と定められています。この記事で扱うアクト・ウィルはここに含まれます。",
    pick: true,
  },
  {
    icon: "document",
    name: "ファクタリング（売掛債権の売却）",
    speed: "速い傾向",
    cost: "手数料方式",
    need: "確定した請求書",
    text: "借入ではなく債権の譲渡なので、負債は増えません。ただし金融庁は、実態が貸付である「偽装ファクタリング」や、無登録業者による高額な手数料について注意を呼びかけています。",
  },
  {
    icon: "truck",
    name: "トラックのリースバック・車両担保",
    speed: "中程度",
    cost: "個別条件",
    need: "売却できる車両",
    text: "保有する車両を売却し、そのまま賃借して使い続ける方法です。車両を手放さずに資金化できますが、契約期間中の解約や改造には制約が生じます。",
  },
];

const terms = [
  ["融資対象", "法人", "", true],
  ["ご融資金額", "300万円〜1億円", "", true],
  ["実質年率", "3.00%〜15.00%", "融資額に応じて金利優遇あり", true],
  ["遅れ損害金年率", "20.00%", "", false],
  ["返済方法", "一括または分割返済", "元金均等払い", false],
  ["返済期間・回数", "1ヶ月〜3年 / 1回〜36回", "", false],
  ["保証人・担保", "第三者保証人・不動産担保は原則不要（要審査）", "法人契約のため代表者の連帯保証は必要", true],
  ["必要書類", "代表者本人を確認する書類、決算書類の一部", "損益計算書、売掛金・買掛金の内訳書など", false],
  ["契約時締結費用", "印紙代（実費）", "", false],
  ["対応エリア", "来店不要・全国対応", "", false],
  ["審査", "最短60分", "仮審査の目安", false],
  ["申込方法", "公式サイト上の専用チャット", "電話での新規申し込みは受付なし", false],
];

const verify = [
  ["商号", "アクト・ウィル株式会社"],
  ["貸金業登録番号", "東京都知事（5）第31521号"],
  ["代表者", "谷口 友祐（タニグチ ユウスケ）"],
  ["所在地", "東京都豊島区東池袋3-11-9 三島ビル301号室"],
  ["電話番号", "03-5944-9168"],
  ["日本貸金業協会 会員番号", "第005834号"],
];

const faqs = [
  ["個人事業主でも利用できますか？", "公式サイトには「融資対象：法人」と記載されています。個人事業主の方は、日本政策金融公庫の融資やファクタリングなど別の手段をご検討ください。"],
  ["他社からの借入があっても相談できますか？", "事業性の法人向け貸付は、貸金業法の総量規制（個人の借入残高を年収の3分の1までに制限する規制）の対象外です。既に借入があることだけを理由に申し込めないわけではありませんが、返済能力に関する審査はあります。"],
  ["審査に通るか不安です。", "審査の基準は公開されておらず、通過を保証できる情報はありません。公式サイトのよくある質問では「他社で断られた場合でも申し込みは可能で、仮審査を行う」旨が案内されていますが、これは申し込みができるという意味であり、融資が受けられるという意味ではありません。"],
  ["本当に即日で資金を受け取れますか？", "公式サイトには「最短即日契約可能」と記載されている一方で、「お申し込みいただいた段階で審査があるため、即日融資実行ができないこともある」とも明記されています。急ぐ場合は午前中までの申し込みがスムーズだと案内されていますが、即日を確約するものではありません。"],
  ["担保や保証人は必要ですか？", "法人契約となるため、代表者の連帯保証は必要です。そのうえで、第三者の保証人や不動産担保は原則不要と記載されています。ただし「一部の融資業務については担保が必要な場合がある」とも記載されており、いずれも審査によります。"],
  ["相談したら、営業電話がかかってきませんか？", "公式サイトには「弊社から電話営業を行うことはございません」と明記されています。また、新規の申し込みは公式サイト上の専用チャットから受け付けており、電話での新規申し込みは受け付けていないと案内されています。"],
  ["来店は必要ですか？地方でも利用できますか？", "公式サイトには「ご来店不要で全国対応」と記載されています。契約後の資金の受け取りは、指定口座への振込、または担当者が現金を直接届ける方法が案内されています。"],
  ["相談した後に断ることはできますか？", "相談や仮審査の申し込みは、契約の締結ではありません。提示された金利・返済額・期間を確認したうえで判断してください。条件に納得できない場合、契約しないという選択は当然に可能です。"],
];
---

<ArticleLayout
  title="運送業の資金調達｜法人向け300万円〜1億円のビジネスローンという選択肢"
  description="運送事業を営む法人向けの資金調達を、公庫・銀行・ビジネスローン・ファクタリング・車両活用の5つで比較。公式サイトと金融庁の登録情報で確認した貸付条件、向いていないケースまで整理しました。"
  updated={UPDATED}
>
  <header class="article-head">
    <p class="article-head__meta">
      <span>最終更新 {UPDATED}</span><span>運送業 / 法人向け</span><span>公式・公的資料で確認</span>
    </p>
    <h1>燃料も給与も先払い。<br />運賃の入金は<mark>そのあと</mark>。</h1>
    <p class="article-head__lead">
      このズレは、経営の巧拙ではなく運送業という仕事の構造から生まれています。そして、支払期日のほうは動かせません。
      運送事業を営む法人が実際に取れる資金調達の選択肢を、公式情報と公的データだけで整理しました。
    </p>
    <div class="article-head__target">
      <p>この記事の対象</p>
      <ul>
        <li>一般貨物・軽貨物などの運送事業を営む<strong>法人</strong></li>
        <li>必要な資金が<strong>300万円以上</strong></li>
        <li>支払期日が決まっていて、<strong>時間に余裕がない</strong></li>
      </ul>
      <small>当てはまらない方向けの選択肢も、記事の中で整理しています。</small>
    </div>
  </header>

  <nav class="toc" aria-label="目次">
    <h2><svg aria-hidden="true"><use href="#i-book" /></svg>この記事の内容</h2>
    <ol>
      {toc.map(([id, label]) => (
        <li><a href={`#${id}`}>{label}</a></li>
      ))}
    </ol>
  </nav>

  <div class="prose">
    <section id="conclusion">
      <h2>結論｜先に答えを書きます<small>読み進める前に、判断の軸だけ渡します</small></h2>

      <p>
        <strong class="em-mark">金利の低さだけで選ぶなら、日本政策金融公庫や銀行の融資が有利です。</strong>
        これは間違いありません。ただし、相談から実行までに一定の時間がかかります。
      </p>
      <p>
        支払期日まで日数がない場合、そもそも間に合わないという問題が起きます。
        そこで候補に挙がるのが、ノンバンク（銀行以外の貸金業者）のビジネスローンです。
      </p>

      <p class="punch">
        間に合わない選択肢は、選択肢になりません。
        <small>金利が安くても、支払期日を過ぎてから実行される融資では目的を果たせません。</small>
      </p>

      <p>
        その一社が、運送事業者向けに貸付条件を公開しているアクト・ウィル株式会社です。
        この記事では、他の資金調達方法との違い、公式に確認できた条件、そして
        <strong class="em-red">向いていないケース</strong>まで確認していきます。
      </p>

      <div class="cta-block">
        <p class="cta-block__head">まず、条件が合うかどうかだけ確認する</p>
        <p class="cta-block__lead">
          融資対象は法人、融資金額は<strong class="em-mark">300万円〜1億円</strong>、実質年率は3.00%〜15.00%。
          相談は無料で、公式サイトには「弊社から電話営業を行うことはございません」と明記されています。
        </p>
        <a class="finance-cta" href={A8} rel="nofollow sponsored noopener" target="_blank">
          <span class="finance-cta__caption">ご融資可能額（目安）</span>
          <strong class="finance-cta__amount" aria-label="300万円から1億円">300<small>万円〜</small>1<small>億円</small></strong>
          <span class="finance-cta__button">公式サイトで貸付条件を確認する <b aria-hidden="true">›</b></span>
          <span class="finance-cta__note">相談は無料です</span>
        </a>
        <p class="cta-block__disclaimer">※審査があるため、融資を保証するものではありません。</p>
      </div>
    </section>

    <section id="check">
      <h2>対象判定｜30秒で「自社が当てはまるか」を確認<small>当てはまらない場合の行き先も書いています</small></h2>

      <table class="kv-table">
        <thead>
          <tr><th scope="col">確認すること</th><th scope="col">判定</th></tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Q1. 法人ですか？</th>
            <td><strong>はい → 次へ</strong><em>いいえ（個人事業主）→ この記事の融資対象は法人です。日本政策金融公庫やファクタリングから検討してください。</em></td>
          </tr>
          <tr>
            <th scope="row">Q2. 必要な金額は300万円以上ですか？</th>
            <td><strong>はい → 次へ</strong><em>いいえ → 最低融資額は300万円です。少額対応のビジネスローンやファクタリングを検討してください。</em></td>
          </tr>
          <tr>
            <th scope="row">Q3. 期日まで1か月を切っていますか？</th>
            <td><strong>はい → 当てはまります</strong><em>いいえ → 金利面で有利な公庫・銀行への相談を先に。並行してノンバンクの条件も調べておくと選択肢が残ります。</em></td>
          </tr>
        </tbody>
      </table>
      <p class="source">3つすべて「はい」なら、この記事の内容がそのまま当てはまります。</p>
    </section>

    <section id="why">
      <h2>理由｜なぜ運送業は「売上があるのに金がない」のか<small>自社だけの問題ではありません。データで確認します</small></h2>

      <h3>理由①｜出ていくのが先、入ってくるのが後</h3>
      <p>運送業では、仕事を受けた時点から支出が始まります。</p>
      <ul class="scan-list">
        <li>燃料費・高速代<small>走った分だけ、その場で発生する</small></li>
        <li>人件費・社会保険料<small>ドライバーの給与は毎月決まった日に支払う</small></li>
        <li>車検・整備・タイヤ交換・突発的な修理<small>金額が大きく、車両を止めれば売上が立たない</small></li>
        <li>保険料・自動車税・重量税<small>時期が重なりやすい</small></li>
      </ul>
      <p>
        一方で、運賃の入金は締め日と支払日を経た後です。2026年1月に施行された中小受託取引適正化法（取適法、旧・下請法）により、
        手形による支払いは原則禁止され、支払期日は受領後60日以内と定められました。
      </p>
      <p>
        制度としては前進しています。しかし
        <strong class="em-mark">「先に払って、後で受け取る」という順番そのものは変わりません。</strong>
      </p>

      <h3>理由②｜上がったコストの、半分しか運賃に乗らない</h3>
      <p>
        中小企業庁が2026年6月26日に公表した「価格交渉促進月間（2026年3月）フォローアップ調査」（回答企業69,625社）の結果です。
      </p>
      <div class="stats">
        <div class="stat">
          <p class="stat__value">48.9%</p>
          <p class="stat__label">エネルギーコストの価格転嫁率<small>燃料が上がっても、およそ半分しか価格に反映できていない</small></p>
        </div>
        <div class="stat">
          <p class="stat__value">50.0%</p>
          <p class="stat__label">労務費の価格転嫁率<small>全業種の平均。全体の転嫁率は54.2%</small></p>
        </div>
        <div class="stat">
          <p class="stat__value">32位</p>
          <p class="stat__label">トラック運送業の順位<small>調査対象32業種中。価格交渉の実施状況・転嫁率とも最下位圏と報じられている</small></p>
        </div>
      </div>
      <p class="source">出典：中小企業庁「価格交渉促進月間（2026年3月）フォローアップ調査」（2026年6月26日公表）。トラック運送業の順位は同調査の業種別ランキングに関する報道による。</p>
      <p>この差が、そのまま<strong class="em-mark">運転資金の必要性</strong>になっています。</p>

      <h3>理由③｜売上が増えるほど、立て替える額も増える</h3>
      <div class="stats">
        <div class="stat">
          <p class="stat__value">1.0%</p>
          <p class="stat__label">営業損益率（全体）<small>前年比 +0.4ポイント</small></p>
        </div>
        <div class="stat">
          <p class="stat__value">48%</p>
          <p class="stat__label">営業赤字の事業者の割合<small>車両10台以下では62%、営業損益率は−2.3%</small></p>
        </div>
        <div class="stat">
          <p class="stat__value">+8.0%</p>
          <p class="stat__label">1者平均の売上高の伸び<small>2億8,521万5,000円。燃料費率は13.5%、軽油は平均166.7円（前年比+9.2%）</small></p>
        </div>
      </div>
      <p class="source">出典：全日本トラック協会「経営分析報告書 令和6年度決算版」（2026年4月公表、分析対象2,631者・報道による）</p>

      <p class="punch">
        売上は8.0%増えているのに、営業損益率は1.0%。
        <small>売上が増えれば、その分だけ先に立て替える燃料費や人件費も増えます。「仕事は増えているのに手元の現金が減る」という感覚には、こうした背景があります。</small>
      </p>

      <div class="box box--point">
        <p class="box__title"><svg aria-hidden="true"><use href="#i-scale" /></svg>制度は前進しているが、時間差は残る</p>
        <p>
          国土交通省は2024年3月22日に「標準的な運賃」を告示し、運賃水準を平均約8%引き上げ、
          燃料サーチャージの基準価格を120.00円/Lと明示しました。荷待ち・荷役が合計2時間を超える場合の割増率5割も新設されています。
        </p>
        <p>ただし告示であり、実際の運賃交渉がまとまるまでには時間がかかります。</p>
      </div>
    </section>

    <section id="compare">
      <h2>比較｜運送業が使える5つの選択肢<small>「お金の出どころ」が違えば、必要なものも時間も変わります</small></h2>

      <div class="compare-stack">
        {methods.map(({ icon, name, speed, cost, need, text, pick }) => (
          <article class:list={["compare-item", pick && "compare-item--pick"]}>
            {pick && <span class="compare-item__badge">この記事で扱う手段</span>}
            <h3><svg aria-hidden="true"><use href={`#i-${icon}`} /></svg>{name}</h3>
            <div class="compare-item__specs">
              <div><span>スピード</span><strong>{speed}</strong></div>
              <div><span>コスト</span><strong>{cost}</strong></div>
              <div><span>必要なもの</span><strong>{need}</strong></div>
            </div>
            <p>{text}</p>
          </article>
        ))}
      </div>
      <p class="source">補足：補助金・助成金は返済不要ですが、公募・審査・精算払いという流れのため当座の運転資金には向きません。</p>

      <p class="punch">
        金利で選ぶなら公庫・銀行。期日で選ぶならビジネスローン、ファクタリング、車両活用。
        <small>ただしファクタリングは確定した請求書、リースバックは車両が前提になります。どちらも用意できない場合に、ビジネスローンが選択肢として残ります。</small>
      </p>

      <div class="cta-block">
        <p class="cta-block__head">運送事業者向けに条件を公開している一社</p>
        <p class="cta-block__lead">
          <strong class="em-mark">法人向け・300万円〜1億円・実質年率3.00%〜15.00%・来店不要で全国対応</strong>と公式サイトに記載されています。
          審査は最短60分（仮審査の目安）。
        </p>
        <a class="finance-cta" href={A8} rel="nofollow sponsored noopener" target="_blank">
          <span class="finance-cta__caption">審査</span>
          <strong class="finance-cta__amount" aria-label="最短60分">最短<small>60</small>分</strong>
          <span class="finance-cta__button">運送業向けの条件を見る <b aria-hidden="true">›</b></span>
          <span class="finance-cta__note">公式サイトへ移動します</span>
        </a>
        <p class="cta-block__disclaimer">※相談は無料です。審査があるため、融資を保証するものではありません。</p>
      </div>
    </section>

    <section id="company">
      <h2>会社｜金融庁の登録情報で確認できること<small>印象や口コミではなく、公的データだけで書きます</small></h2>

      <p>
